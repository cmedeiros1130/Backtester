{
  "name": "levelforge",
  "private": true,
  "version": "1.0.0",
  "description": "LevelForge - a filing cabinet for trading research",
  "type": "module",
  "engines": {
    "node": ">=23.4.0"
  },
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:server": "npm run dev --workspace levelforge-server",
    "dev:client": "npm run dev --workspace levelforge-client",
    "build": "npm run build --workspace levelforge-client",
    "start": "node server/src/index.js"
  }
}
