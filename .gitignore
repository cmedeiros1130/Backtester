# ---------------------------------------------------------------------------
# Dependencies — reinstalled from package-lock.json, never committed.
# This is what made the folder 126 MB.
# ---------------------------------------------------------------------------
node_modules/
.npm/
.pnpm-store/

# ---------------------------------------------------------------------------
# Build output — regenerated by `npm run build` on every deploy.
# ---------------------------------------------------------------------------
dist/
build/
client/dist/
.vite/
*.tsbuildinfo

# ---------------------------------------------------------------------------
# YOUR RESEARCH — stays on this machine, never goes to GitHub.
#
# The database and every screenshot you file live under data/. In production
# these live on the host's persistent disk (LEVELFORGE_DATA_DIR), so GitHub
# only ever needs the code that creates them.
#
# data/uploads/.gitkeep is the one exception, so the directory exists in a
# fresh clone.
# ---------------------------------------------------------------------------
# Note: `data/*` not `data/` — git cannot re-include anything inside a
# directory that is itself excluded, so the .gitkeep below would be ignored.
data/*
!data/uploads/
data/uploads/*
!data/uploads/.gitkeep

# SQLite anywhere, in case a database is ever created outside data/.
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# ---------------------------------------------------------------------------
# Secrets and local configuration.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key

# ---------------------------------------------------------------------------
# Logs, caches, temporary files.
# ---------------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.cache/
tmp/
temp/
*.tmp
coverage/

# ---------------------------------------------------------------------------
# Editor and OS noise.
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*~
